# ============================================================================
# More Space backend — environment / secrets
# Edge Functions automatically receive SUPABASE_URL, SUPABASE_ANON_KEY and
# SUPABASE_SERVICE_ROLE_KEY. The values below are the EXTRA secrets you set
# yourself: Dashboard → Project Settings → Edge Functions → Secrets,
# or:  supabase secrets set KEY=value
# ============================================================================

# ---- Chatbot (OpenRouter) -------------------------------------------------
# REQUIRED for live AI replies. ROTATE the key you shared in chat first!
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=openai/gpt-4o-mini        # any OpenRouter model id (e.g. anthropic/claude-3.5-sonnet)

# ---- ElevenLabs voice (optional — for auto-calling later) -----------------
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=                 # sent by ElevenLabs as the x-webhook-secret header
ADMIN_API_SECRET=                          # your CRM/n8n sends this as x-admin-secret to voice-initiate

# ---- Frontend (PUBLIC values — already hard-coded in js/main.js) ----------
SUPABASE_URL=https://aszxypvnndlzzdmzwkrr.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_VywXCKPvxn5SLRehohV8dQ_9wOO9FkA
